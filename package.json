{
  "name": "smart-society-management",
  "version": "1.0.0",
  "description": "Smart Society Management System for housing societies",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "client": "npm run client:user",
    "client:user": "cd frontend-user && npm start",
    "client:admin": "cd frontend-admin && npm start",
    "dev:all:user": "concurrently \"npm run dev\" \"npm run client:user\"",
    "dev:all:admin": "concurrently \"npm run dev\" \"npm run client:admin\"",
    "dev:all:panels": "concurrently \"npm run dev\" \"npm run client:user\" \"npm run client:admin\""
  },
  "keywords": [
    "society",
    "management",
    "complaint",
    "maintenance",
    "payment"
  ],
  "author": "Anshu Sharma",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "prop-types": "^15.8.1",
    "razorpay": "^2.9.2",
    "react-chartjs-2": "^5.3.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
